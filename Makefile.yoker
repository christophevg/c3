# This is a general purpose Yoker-supporting Makefile that can be included by projects.
# simply add "-include <path to>/c3/Makefile.yoker" at the top of a local project
# Makefile to have easy Yoker support.
# If you have yoker itself as a repo located on your system and want to use that version
# of Yoker, implement the `YOKER_FROM` env var in your Makefile before including this.
# e.g. YOKER_FROM ?= ../yoker
# Without it, the latest released version of Yoker will be used from PyPI.
# By default we include already some common env var providing sources
-include .env
-include .env.local
-include Makefile.local

ifdef YOKER_FROM
YOKER=uv run --with-editable ${YOKER_FROM} yoker
else
YOKER=uvx yoker
endif

YOKER_ARGS =
ifdef YOKER_SESSION
YOKER_ARGS += --session-id $(YOKER_SESSION)
endif

ifdef YOKER_RESUME
YOKER_ARGS += --resume $(YOKER_RESUME)
endif

all: yoker-chat ## Main/default target, starts an interactive chat with Yoker

yoker-chat: ## Start an interactive chat with Yoker
	@$(YOKER) chat $(YOKER_ARGS)

yoker-init: ## Initialize a local `yoker.toml` configuration using the Wizard
	@$(YOKER) init --path yoker.toml

# COLORS

GREEN=\033[0;32m
RED=\033[0;31m
BLUE=\033[0;34m
AMBER=\033[33m
GREEN_BOLD=\033[1;32m
RED_BOLD=\033[1;31m
BLUE_BOLD=\033[1;36m
AMBER_BOLD=\033[1;33m
NC=\033[0m

# the following targets activate a specific agent

project: YOKER_ARGS += --agent project-manager
project: yoker-chat  ## Work on this project with the project-manager agent.

analyst: YOKER_ARGS += --agent "functional-analyst"
analyst: yoker-chat  ## Work on this project with the functional-analyst agent.

# the following targets select an agent and inject also an initial prompt to start
# NOTE: this doesn't work right now, due to missing CLI prompt support in Yoker

manage: YOKER_PROMPT = "manage the project!"
manage: project  ## Manage the current project using the project-manager agent.

review: YOKER_PROMPT = "I want to review the project. The goal is to update the requirements, functional analysis and backlog/TODO.md to match my intentions. Let's do this interactively and discuss each of the requirements and proposed features to evaluate if I still want them, and in what form, along with possibly other features I might want. Interview me until everything is clear, is consistent and I have confirmed everything."
review: analyst ## Review the current project using the functional-analyst agent.

refine: YOKER_PROMPT = "I want to review the project. The goal is to refine the backlog, to ensure it's optimally organized to deliver value. This includes reviewing the list of unstructured MBIs and/or TODOs to ensure all TODOs are well aligned with the intended MBIs, and ready to be processed by the development team. Don't decide anything on your own, ask me, guiding me through all open MBIs, TODOs. Before asking, check that open tasks aren't incorrectly marked as open, while they are already committed. You don't need to analyse everything in this session, just make sure that my intentions are clear enough to structured them into a prioritized overall backlog."
refine: analyst  ## Refine this project's backlog with the functional-analyst agent.


# other supporting targets

generated-image: ## Generate an image in a shell or using PROMPT env var
	ollama run x/z-image-turbo ${PROMPT}

git-personal: ## Start a subshell with personal git identity
	@GIT_AUTHOR_NAME=$$(git config --global user.name); \
	GIT_AUTHOR_EMAIL=$$(git config --global user.email); \
	if [ -z "$$GIT_AUTHOR_NAME" ]; then \
		echo "$(RED_BOLD)Error: Git global user.name not set$(NC)"; \
		echo ""; \
		echo "$(AMBER)To setup personal git identity:$(NC)"; \
		echo "  git config --global user.name \"Your Name\""; \
		echo "  git config --global user.email \"your.email@example.com\""; \
		exit 1; \
	fi; \
	echo "$(GREEN_BOLD)Entering personal Git shell...$(NC)"; \
	echo "$(GREEN_BOLD)Git identity: $$GIT_AUTHOR_NAME <$$GIT_AUTHOR_EMAIL>$(NC)"; \
	echo "$(AMBER_BOLD)Type 'exit' or Ctrl+D to return to agent mode$(NC)"; \
	GIT_AUTHOR_NAME="$$GIT_AUTHOR_NAME" \
	GIT_AUTHOR_EMAIL="$$GIT_AUTHOR_EMAIL" \
	GIT_COMMITTER_NAME="$$GIT_AUTHOR_NAME" \
	GIT_COMMITTER_EMAIL="$$GIT_AUTHOR_EMAIL" \
	PROMPT="%n@%m %1~ %F{red}(personal)%f%# " zsh -f -i

## Help

help: help-intro help-global help-local ## Show this help message

help-intro:
	@echo "Usage: make [target]"
	@echo ""
	@echo "Available targets:"

help-global:
	@if [ -f ~/.yoker/Makefile ]; then \
		echo ""; \
		echo "$(GREEN_BOLD)C3$(NC)"; \
		grep -E '^[a-zA-Z_-]+:.*?## .*$$' ~/.yoker/Makefile | sort | awk 'BEGIN {FS = ":.*?## "}; {printf "  $(BLUE_BOLD)%-15s$(NC) %s\n", $$1, $$2}'; \
	fi

help-local:
	@echo ""
	@echo "$(GREEN_BOLD)Local$(NC)"
	@grep -E '^[a-zA-Z_-]+:.*?## .*$$' Makefile | sort | awk 'BEGIN {FS = ":.*?## "}; {printf "  $(BLUE_BOLD)%-15s$(NC) %s\n", $$1, $$2}'
