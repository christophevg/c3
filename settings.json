{
  "skillListingBudgetFraction": 0.03,
  "attribution": {
    "commit": "🤖 Implemented together with a coding agent.",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(pip show:*)",
      "Bash(pip list:*)",
      "Bash(make envs:*)",
      "Bash(make lint:*)",
      "Bash(make test:*)",
      "Bash(make coverage:*)",
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(git add:*)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "uv run python ~/.claude/bin/statusline.py"
  },
  "awaySummaryEnabled": false,
  "theme": "light",
  "editorMode": "normal",
  "verbose": false,
  "terminalProgressBarEnabled": true,
  "env": {
    "API_TIMEOUT_MS": "1200000",
    "BASH_DEFAULT_TIMEOUT_MS": "300000",
    "CLAUDE_CODE_DISABLE_AUTO_MEMORY" : "1"
  },
  "autoMemoryEnabled": false
}
