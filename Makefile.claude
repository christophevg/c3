-include .env
-include .env.local

MODEL  ?= glm-5:cloud   # our preferred model ;-)
ARGS   ?=               # optional additional CLI arguments
PROMPT ?=               # optional initial prompt

ifdef QWEN
MODEL = qwen3.5:397b-cloud   # sometimes qwen is better
endif

ifneq (,$(wildcard skills/))
ARGS += --plugin-dir ./		   # if we expose our own skills
endif

C3_FOLDER ?= ../c3

ifneq ($(C3_FOLDER),./)             # don't include local C3 twice
ifneq (,$(wildcard $(C3_FOLDER)))
ARGS += --plugin-dir $(C3_FOLDER)   # use the local C3 plugin if available
endif
endif

PKGQ_FOLDER ?= ../pkgq

ifneq ($(PKGQ_FOLDER),./)             # don't include local PKGQ twice
ifneq (,$(wildcard $(PKGQ_FOLDER)))
ARGS += --plugin-dir $(PKGQ_FOLDER)   # use the local PKGQ plugin if available
endif
endif

# COLORS

GREEN=\033[0;32m
RED=\033[0;31m
BLUE=\033[0;34m
AMBER=\033[33m
GREEN_BOLD=\033[1;32m
RED_BOLD=\033[1;31m
BLUE_BOLD=\033[1;36m
AMBER_BOLD=\033[1;33m
NC=\033[0m

all: claude

claude:  ## Start a Claude Code session.
	ollama launch claude --model ${MODEL} -- $(ARGS) $(PROMPT)

resume: ARGS += --resume
resume: claude  ## Resume a previous Claude Code session

# the following targets activate a specific agent

assistant: ARGS += --agent "c3:assistant"
assistant: claude  ## Work on this project with the assistant agent.

project: ARGS += --agent c3:project-manager
project: claude  ## Work on this project with the project-manager agent.

analyst: ARGS += --agent "c3:functional-analyst"
analyst: claude  ## Work on this project with the functional-analyst agent.

# the following targets select an agent and inject also an initial prompt to start

manage: PROMPT = "manage the project!"
manage: project  ## Manage the current project using the project-manager agent.

review: PROMPT = "I want to review the project. The goal is to update the requirements, functional analysis and backlog/TODO.md to match my intentions. Let's do this interactively and discuss each of the requirements and proposed features to evaluate if I still want them, and in what form, along with possibly other features I might want. Interview me until everything is clear, is consistent and I have confirmed everything."
review: analyst ## Review the current project using the functional-analyst agent.

refine: PROMPT = "I want to review the project. The goal is to refine the backlog, to ensure it's optimally organized to deliver value. This includes reviewing the list of unstructured MBIs and/or TODOs to ensure all TODOs are well aligned with the intended MBIs, and ready to be processed by the development team. Don't decide anything on your own, ask me, guiding me through all open MBIs, TODOs. Before asking, check that open tasks aren't incorrectly marked as open, while they are already committed. You don't need to analyse everything in this session, just make sure that my intentions are clear enough to structured them into a prioritized overall backlog."
refine: analyst  ## Refine this project's backlog with the functional-analyst agent.


generated-image: ## Generate an image in a shell or using PROMPT env var
	ollama run x/z-image-turbo ${PROMPT}

git-personal: ## Start a subshell with personal git identity
	@GIT_AUTHOR_NAME=$$(git config --global user.name); \
	GIT_AUTHOR_EMAIL=$$(git config --global user.email); \
	if [ -z "$$GIT_AUTHOR_NAME" ]; then \
		echo "$(RED_BOLD)Error: Git global user.name not set$(NC)"; \
		echo ""; \
		echo "$(AMBER)To setup personal git identity:$(NC)"; \
		echo "  git config --global user.name \"Your Name\""; \
		echo "  git config --global user.email \"your.email@example.com\""; \
		exit 1; \
	fi; \
	echo "$(GREEN_BOLD)Entering personal Git shell...$(NC)"; \
	echo "$(GREEN_BOLD)Git identity: $$GIT_AUTHOR_NAME <$$GIT_AUTHOR_EMAIL>$(NC)"; \
	echo "$(AMBER_BOLD)Type 'exit' or Ctrl+D to return to agent mode$(NC)"; \
	GIT_AUTHOR_NAME="$$GIT_AUTHOR_NAME" \
	GIT_AUTHOR_EMAIL="$$GIT_AUTHOR_EMAIL" \
	GIT_COMMITTER_NAME="$$GIT_AUTHOR_NAME" \
	GIT_COMMITTER_EMAIL="$$GIT_AUTHOR_EMAIL" \
	PROMPT="%n@%m %1~ %F{red}(personal)%f%# " zsh -f -i

## Help

help: ## Show this help message
	@echo "Usage: make [target]"
	@echo ""
	@echo "Available targets:"
	@echo ""
	@echo "$(GREEN_BOLD)C3$(NC)"
	@grep -E '^[a-zA-Z_-]+:.*?## .*$$' ~/.claude/Makefile | grep -v "install-pythons\|sync" | sort | awk 'BEGIN {FS = ":.*?## "}; {printf "  $(BLUE_BOLD)%-15s$(NC) %s\n", $$1, $$2}'
	@echo ""
	@echo "$(GREEN_BOLD)Local$(NC)"
	@grep -E '^[a-zA-Z_-]+:.*?## .*$$' Makefile | grep -v "install-pythons\|sync" | sort | awk 'BEGIN {FS = ":.*?## "}; {printf "  $(BLUE_BOLD)%-15s$(NC) %s\n", $$1, $$2}'
